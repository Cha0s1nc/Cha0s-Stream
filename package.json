{
  "name": "cha0s-listener",
  "version": "1.2.0",
  "description": "Cha0s Bot Listener — OBS & Jellyfin bridge with dashboard",
  "author": {
    "name": "Cha0s1nc",
    "email": "cha0s@chaosinc.xyz"
  },
  "main": "electron/main.js",
  "bin": "electron/main.js",
  "scripts": {
    "start": "node listener.js",
    "electron": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.cha0sinc.listener",
    "productName": "Cha0s Listener",
    "files": [
      "electron/**/*",
      "listener.js",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "Cha0s1nc",
      "repo": "cha0s_listener"
    },
    "mac": {
      "identity":"Cha0s_1nc_Development",
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "electron-store": "^8.0.0",
    "electron-updater": "^6.1.7",
    "express": "^4.18.2",
    "obs-websocket-js": "^5.0.3",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  }
}
