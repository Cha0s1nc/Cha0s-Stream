# Normalize line endings: always store as LF in git, check out as CRLF on Windows
* text=auto eol=lf

# Explicitly LF for source files
*.js      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.env     text eol=lf

# Binaries — no line ending conversion
*.ico     binary
*.icns    binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.exe     binary
*.dll     binary
